{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT:-${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/copilot/session-start.js\"",
        "powershell": "$r = if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } elseif ($env:COPILOT_PLUGIN_ROOT) { $env:COPILOT_PLUGIN_ROOT } elseif ($env:CLAUDE_PLUGIN_ROOT) { $env:CLAUDE_PLUGIN_ROOT } else { '${CLAUDE_PLUGIN_ROOT}' }; node \"$r/copilot/session-start.js\"",
        "command": "node \"${PLUGIN_ROOT:-${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/copilot/session-start.js\"",
        "timeoutSec": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Write|Edit|MultiEdit|create|edit|str_replace_editor|apply_patch",
        "bash": "node \"${PLUGIN_ROOT:-${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/copilot/post-tool-use.js\"",
        "powershell": "$r = if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } elseif ($env:COPILOT_PLUGIN_ROOT) { $env:COPILOT_PLUGIN_ROOT } elseif ($env:CLAUDE_PLUGIN_ROOT) { $env:CLAUDE_PLUGIN_ROOT } else { '${CLAUDE_PLUGIN_ROOT}' }; node \"$r/copilot/post-tool-use.js\"",
        "command": "node \"${PLUGIN_ROOT:-${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/copilot/post-tool-use.js\"",
        "timeoutSec": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT:-${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/copilot/stop.js\"",
        "powershell": "$r = if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } elseif ($env:COPILOT_PLUGIN_ROOT) { $env:COPILOT_PLUGIN_ROOT } elseif ($env:CLAUDE_PLUGIN_ROOT) { $env:CLAUDE_PLUGIN_ROOT } else { '${CLAUDE_PLUGIN_ROOT}' }; node \"$r/copilot/stop.js\"",
        "command": "node \"${PLUGIN_ROOT:-${COPILOT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/copilot/stop.js\"",
        "timeoutSec": 5
      }
    ]
  }
}
